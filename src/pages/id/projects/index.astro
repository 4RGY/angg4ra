---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';

const all = await getCollection('projects');
const projects = all
  .filter(p => !p.id.endsWith('-en'))
  .sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')));
---
<BaseLayout title="Proyek · Anggara" lang="id">
  <div class="page-container">
    <header class="page-head">
      <p class="eyebrow">Koleksi lengkap · {projects.length} proyek</p>
      <h1>Proyek</h1>
      <p class="lede">Semua pekerjaan yang selesai didokumentasikan: analisis data, otomasi, dan alat bantu. Diurutkan dari yang terbaru.</p>
    </header>
    <ul class="index-list">
      {projects.map(p => (
        <li>
          <a href={`/id/projects/${p.id}/`}>
            <span class="cat">{p.data.category}</span>
            <span class="title">{p.data.title}</span>
            <span class="desc">{p.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-container { position: relative; z-index: 1; max-width: 62rem; margin: 0 auto; padding: 8rem 1.5rem 6rem; }
  .eyebrow { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 0 0 .8rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 .6rem; }
  .lede { color: var(--text-secondary); max-width: 40rem; margin: 0 0 2.5rem; }
  .index-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .index-list li { border-bottom: 1px solid var(--border); }
  .index-list a { display: grid; grid-template-columns: 9rem 1fr; grid-template-areas: 'cat title' 'cat desc'; gap: .15rem 1.25rem; padding: 1.1rem .25rem; text-decoration: none; color: inherit; transition: background .2s; }
  .index-list a:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .cat { grid-area: cat; font-family: var(--font-mono); font-size: .74rem; letter-spacing: .05em; color: var(--text-secondary); padding-top: .25rem; }
  .title { grid-area: title; font-weight: 650; }
  .desc { grid-area: desc; color: var(--text-secondary); font-size: .88rem; }
  @media (max-width: 640px) { .index-list a { grid-template-columns: 1fr; grid-template-areas: 'cat' 'title' 'desc'; } }
</style>

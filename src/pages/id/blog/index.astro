---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';

const all = await getCollection('blog');
const posts = all
  .filter(p => !p.id.endsWith('-en'))
  .sort((a, b) => String(b.data.date ?? '').localeCompare(String(a.data.date ?? '')));
const fmt = d => new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Tulisan · Anggara" lang="id">
  <div class="page-container">
    <header class="page-head">
      <p class="eyebrow">Catatan log · {posts.length} tulisan</p>
      <h1>Tulisan</h1>
      <p class="lede">Catatan tentang data, kode, dan mengajar. Ditulis saat ada hal yang layak diingat.</p>
    </header>
    <ul class="index-list">
      {posts.map(p => (
        <li>
          <a href={`/id/blog/${p.id}/`}>
            <time datetime={String(p.data.date)}>{fmt(p.data.date)}</time>
            <span class="title">{p.data.title}</span>
            <span class="desc">{p.data.excerpt}</span>
            <span class="read">{p.data.readingTime} mnt</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-container { position: relative; z-index: 1; max-width: 62rem; margin: 0 auto; padding: 8rem 1.5rem 6rem; }
  .eyebrow { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 0 0 .8rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 .6rem; }
  .lede { color: var(--text-secondary); max-width: 40rem; margin: 0 0 2.5rem; }
  .index-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .index-list li { border-bottom: 1px solid var(--border); }
  .index-list a { display: grid; grid-template-columns: 6.5rem 1fr 3.5rem; grid-template-areas: 'date title read' 'date desc read'; gap: .15rem 1rem; padding: 1.1rem .25rem; text-decoration: none; color: inherit; transition: background .2s; }
  .index-list a:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  time { grid-area: date; font-family: var(--font-mono); font-size: .74rem; color: var(--text-secondary); padding-top: .3rem; }
  .title { grid-area: title; font-weight: 650; }
  .desc { grid-area: desc; color: var(--text-secondary); font-size: .88rem; }
  .read { grid-area: read; font-family: var(--font-mono); font-size: .74rem; color: var(--text-secondary); text-align: right; padding-top: .3rem; }
  @media (max-width: 640px) { .index-list a { grid-template-columns: 1fr 3.5rem; grid-template-areas: 'date read' 'title title' 'desc desc'; } }
</style>

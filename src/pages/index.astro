  const PROJ = [
    /* 0 confusion matrix, blue is the Recyclable/Organic mix-up */
    (w, h) => raster(w, h, c => {
      const s = Math.min(w, h) * .9, x0 = (w - s) / 2, y0 = (h - s) / 2, gap = s * .04, cs = (s - 2 * gap) / 3;
      const f = [[1, .16, .6], [.08, 1, .1], [.55, .14, 1]];
      for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) {

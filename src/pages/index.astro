    pts.length = N; return pts;
  };
  const raster = (w, h, draw, o = {}) => {
    oc.width = Math.max(8, Math.ceil(w)); oc.height = Math.max(8, Math.ceil(h));
    octx.clearRect(0, 0, oc.width, oc.height); octx.fillStyle = '#000'; octx.strokeStyle = '#000'; octx.textBaseline = 'alphabetic'; octx.textAlign = 'left';

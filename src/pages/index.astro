    for (; g >= (o.gmin || 2.5); g -= .25) { pts = grab(g); if (pts.length >= N) break; }
    return { pts: trim(pts), g };
  };

  const nameLayout = (c, w, h) => {
    setFont(c, 100); const w100 = c.measureText('angg4ra.').width;
    const fs = Math.min(w * .985 / w100 * 100, h / .95);
    setFont(c, fs);
    const mw = c.measureText('angg4ra').width, pw = c.measureText('.').width, mm = c.measureText('angg4ra.');
    const asc = mm.actualBoundingBoxAscent, desc = mm.actualBoundingBoxDescent;

  /* =============== THE CANVAS: one dataset that reshapes itself for every section =============== */
  const cv = $('#field'), ctx = cv.getContext('2d');
  const hero = $('#top');
  const rnd = mulberry(11);
  const hex = s => { s = s.trim().replace('#', ''); return [0, 2, 4].map(i => parseInt(s.slice(i, i + 2), 16)); };
  let altC = [217, 220, 225], blueC = [43, 91, 255], altCss = '', blueCss = '';
  const readColors = () => {
    const cs = getComputedStyle(root);
    altC = hex(cs.getPropertyValue('--alt')); blueC = hex(cs.getPropertyValue('--blue'));
    altCss = `rgb(${altC.join(',')})`; blueCss = `rgb(${blueC.join(',')})`;
  };
  readColors();

  let W = 0, H = 0, dpr = 1, N = 0, dots = [], cache = {}, inited = false;
  const stages = { name: $('#st-name'), proj: $('#st-proj'), res: $('#st-res'), lab: $('#st-lab'), about: $('#st-about'), sig: $('#st-sig') };
  const KEY = { name: 0, proj: 0, res: 0, lab: 'bottle', about: 0, sig: 0 };
  const rects = {};
  const S = { r: 2.4, rT: 2.4, la: 0, laT: 0 };
  const lens = { x: 0, y: 0, tx: 0, ty: 0, R: 118 };
  let cur = 'ambient', needRetarget = false, hold = !reduce, introPending = true, lastMove = -1e9, seen = false, raf = 0, last = 0, tick2 = 0;

  /* ---- sampling helpers: draw a shape in black (normal) or red (accent), read it back as dot positions ---- */
  const oc = document.createElement('canvas'), octx = oc.getContext('2d', { willReadFrequently: true });
  const FAM = 'Archivo, system-ui, sans-serif';
  const setFont = (c, px) => {
    c.font = `800 expanded ${px}px ${FAM}`;
    if (!/Archivo/.test(c.font)) { c.font = `800 ${px}px ${FAM}`; if ('fontStretch' in c) c.fontStretch = 'expanded'; }
  };
  const rrect = (c, x, y, w, h, r) => {
    r = Math.min(r, w / 2, h / 2); c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath();
  };

      for (let y = g / 2; y < oh; y += g) for (let x = g / 2; x < ow; x += g) { const i = (((y | 0) * ow) + (x | 0)) * 4; if (data[i + 3] > 128) pts.push({ x, y, k: data[i] > 128 ? 1 : 0 }); }

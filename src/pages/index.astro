<style is:inline>
/* ---------- tokens ----------
   base 60%  #121417   alt 30%  #d9dce1   blue 10%  #2b5bff
   Contrast: alt on base 13.4. Blue is only ever a shape, line or dot (3.5 to 3.8),
   never small text. The theme toggle swaps base and alt, blue stays. */
:root{
  --base:#121417; --alt:#d9dce1; --blue:#2b5bff;
  --line:color-mix(in srgb,var(--alt) 15%,transparent);
  --line2:color-mix(in srgb,var(--alt) 32%,transparent);
  --mute:color-mix(in srgb,var(--alt) 62%,var(--base));
  --pline:color-mix(in srgb,var(--base) 18%,transparent);
  --pmute:color-mix(in srgb,var(--base) 62%,var(--alt));
  --ease:cubic-bezier(.2,.8,.2,1);
  --f:"Archivo",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:dark;
}
:root[data-theme="light"]{--base:#d9dce1;--alt:#121417;color-scheme:light}

/* ---------- base ---------- */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--base);color:var(--alt);font:400 1.0625rem/1.6 var(--f);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,p,ul,dl,dd,figure{margin:0}
ul{padding:0;list-style:none}
a{color:inherit}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
::selection{background:var(--blue);color:#d9dce1}
.wrap{max-width:1200px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}
.sec{padding:clamp(72px,10vw,130px) 0}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;background:var(--alt);color:var(--base);padding:8px 14px;border-radius:99px;z-index:100}
.skip:focus{left:8px}
h2{font-size:clamp(2rem,5.2vw,4.4rem);line-height:.95;font-weight:800;font-stretch:125%;letter-spacing:-.035em}
.an{font-stretch:75%;font-weight:500;font-size:.85rem;letter-spacing:.01em;font-variant-numeric:tabular-nums}
.muted{color:var(--mute)}
.sec-h{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(28px,5vw,56px)}

/* heading wipe, the only scroll entrance for headings */
.js .wipe{clip-path:inset(0 0 100% 0);transform:translateY(30%);transition:clip-path .8s var(--ease),transform .8s var(--ease)}
.js .wipe.in{clip-path:inset(0);transform:none}

/* layers: grid under the canvas, content over it, opaque panels hide the dots behind them */
#grid{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.55;
  background-image:
    linear-gradient(var(--line2) 1px,transparent 1px),linear-gradient(90deg,var(--line2) 1px,transparent 1px),
    linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:240px 240px,240px 240px,48px 48px,48px 48px}
#field{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;display:block}
main{position:relative;z-index:2}

/* corner brackets and crop marks, the signature device */
.box,.crop::after{--c:var(--blue);
  background:
    linear-gradient(var(--c),var(--c)) top left/14px 2px,
    linear-gradient(var(--c),var(--c)) top left/2px 14px,
    linear-gradient(var(--c),var(--c)) top right/14px 2px,
    linear-gradient(var(--c),var(--c)) top right/2px 14px,
    linear-gradient(var(--c),var(--c)) bottom left/14px 2px,
    linear-gradient(var(--c),var(--c)) bottom left/2px 14px,
    linear-gradient(var(--c),var(--c)) bottom right/14px 2px,
    linear-gradient(var(--c),var(--c)) bottom right/2px 14px;
  background-repeat:no-repeat}
.box{position:absolute;inset:-1px;pointer-events:none;opacity:0;transition:opacity .25s,transform .35s var(--ease);transform:scale(1.015)}
.crop{position:relative}
.crop::after{content:"";position:absolute;inset:-9px;pointer-events:none}

/* ---------- ruler, nav ---------- */
.ruler{position:fixed;left:0;top:0;bottom:0;width:18px;z-index:40;overflow:hidden;border-right:1px solid var(--line2);background:color-mix(in srgb,var(--base) 60%,transparent)}
.ruler i{position:absolute;left:0;right:0;top:-50px;bottom:-50px;
  background:
    repeating-linear-gradient(to bottom,var(--line2) 0 1px,transparent 1px 50px) 0 0/14px 100% no-repeat,
    repeating-linear-gradient(to bottom,var(--line) 0 1px,transparent 1px 10px) 0 0/7px 100% no-repeat}
.ruler b{position:absolute;left:0;top:30px;width:18px;height:3px;background:var(--blue)}
@media (max-width:760px){.ruler{display:none}}

nav.top,nav.top *{white-space:nowrap}
nav.top{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:50;display:flex;align-items:center;gap:6px;
  padding:6px 6px 6px 10px;background:color-mix(in srgb,var(--base) 78%,transparent);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid var(--line2);border-radius:99px;max-width:calc(100% - 24px)}
.mark{position:relative;width:34px;height:34px;display:grid;place-items:center;font-weight:800;font-stretch:125%;font-size:1.2rem;text-decoration:none;margin-right:4px;letter-spacing:-.04em}
.mark .box{opacity:1;transform:none}
.mark em{font-style:normal;color:var(--blue)}
nav .links{display:flex;gap:2px}
nav .links a{padding:7px 12px;border-radius:99px;text-decoration:none;font-size:.92rem;font-weight:500;color:var(--mute);transition:color .2s,background .2s}
nav .links a:hover{color:var(--alt);background:var(--line)}
nav .links a[aria-current=true]{color:var(--base);background:var(--alt)}
.icon-btn{min-width:34px;height:34px;border-radius:99px;border:1px solid var(--line2);background:transparent;cursor:pointer;display:grid;place-items:center;padding:0 9px;font-size:.78rem;font-weight:600;color:var(--mute)}
.icon-btn:hover{border-color:var(--alt);color:var(--alt)}
.icon-btn b{color:var(--alt)}
.icon-btn i{width:14px;height:14px;border-radius:50%;background:var(--alt);box-shadow:inset -5px -3px 0 0 var(--base);transition:transform .5s var(--ease)}
:root[data-theme=light] .icon-btn i{transform:rotate(180deg)}
.pill{display:inline-flex;align-items:center;padding:7px 14px 7px 12px;border-radius:99px;background:var(--alt);color:var(--base);font-weight:600;font-size:.92rem;text-decoration:none}
.pill i{width:7px;height:7px;border-radius:50%;background:var(--blue);margin-right:8px}
.pill:hover{opacity:.88}
.js nav.top{opacity:0;transform:translate(-50%,-10px);transition:opacity .6s var(--ease),transform .6s var(--ease)}
.js.ready nav.top{opacity:1;transform:translate(-50%,0)}

/* theme switch: circle wipe from the toggle */
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
::view-transition-old(root){z-index:1}
::view-transition-new(root){z-index:2}
::view-transition-group(*){animation-duration:.5s;animation-timing-function:var(--ease)}

/* ---------- hero ---------- */
.hero{position:relative;min-height:100svh;display:flex}
.hero-in{display:flex;flex-direction:column;flex:1;width:100%;padding-top:92px;padding-bottom:26px}
#st-name{flex:1;min-height:210px}
.dim{display:flex;align-items:center;gap:14px;color:var(--mute);margin:10px 0 24px}
.dim i{flex:1;height:9px;background:linear-gradient(var(--line2),var(--line2)) center/100% 1px no-repeat}
.dim i:first-child{border-left:1px solid var(--line2)}
.dim i:last-child{border-right:1px solid var(--line2)}
.hero-foot{display:grid;grid-template-columns:minmax(0,34rem) minmax(0,25rem);justify-content:space-between;align-items:end;gap:28px}
.lead{font-size:clamp(1.05rem,1.7vw,1.35rem);line-height:1.45}
.hint{margin-top:14px;color:var(--mute)}
.tblock{display:grid;grid-template-columns:auto 1fr;border:1px solid var(--line2);background:color-mix(in srgb,var(--base) 72%,transparent)}
.tblock dt,.tblock dd{margin:0;padding:9px 13px;border-bottom:1px solid var(--line2)}
.tblock dt{color:var(--mute);border-right:1px solid var(--line2);font-stretch:75%;font-weight:500;font-size:.88rem}
.tblock>:nth-last-child(-n+2){border-bottom:0}
.live{display:inline-block;width:8px;height:8px;margin-right:9px;background:var(--blue);border-radius:50%;animation:pulse 2.4s ease-out infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--blue) 70%,transparent)}70%,100%{box-shadow:0 0 0 9px transparent}}
.js .dim,.js .lead,.js .hint,.js .tblock{opacity:0;transform:translateY(10px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.js .tblock{transform:none;clip-path:inset(0 100% 0 0);transition:clip-path .9s var(--ease),opacity .4s}
.js .hero.go .dim,.js .hero.go .lead,.js .hero.go .hint{opacity:1;transform:none}
.js .hero.go .hint{transition-delay:.25s}
.js .hero.go .tblock{opacity:1;clip-path:inset(0)}

/* ---------- stages (the dots draw into these boxes) ---------- */
.stage{position:relative}
.figcap{margin-top:12px;color:var(--mute);font-size:.88rem;max-width:34rem}

/* ---------- panels (30%) ---------- */
.panel{background:var(--alt);color:var(--base);padding:clamp(18px,3vw,34px)}
.panel .muted,.panel .pm{color:var(--pmute)}
.split{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(24px,4.5vw,72px);align-items:start}
.stagecol{position:sticky;top:104px;align-self:start}
#st-proj{height:min(58vh,500px)}

.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.chip{padding:7px 14px;border-radius:99px;border:1px solid var(--pline);background:transparent;cursor:pointer;font-weight:500;font-size:.92rem;transition:background .2s,border-color .2s,color .2s}
.chip:hover{border-color:var(--base)}
.chip[aria-pressed=true]{background:var(--base);color:var(--alt);border-color:var(--base)}
.chip .n{color:var(--pmute);margin-left:6px;font-variant-numeric:tabular-nums}
.chip[aria-pressed=true] .n{color:inherit;opacity:.65}
.rows{border-bottom:1px solid var(--pline)}
.row{position:relative;border-top:1px solid var(--pline)}
.row[hidden]{display:none}
.row-h{display:grid;grid-template-columns:1fr auto;align-items:center;gap:16px;width:100%;padding:22px 4px;text-align:left;background:none;border:0;cursor:pointer}
.row-h .t{display:block;font-size:clamp(1.1rem,2vw,1.55rem);line-height:1.1;font-weight:700;font-stretch:112%;letter-spacing:-.02em;transition:transform .45s var(--ease)}
.row-h:hover .t,.row-h:focus-visible .t,.row.act .t{transform:translateX(10px)}
.tags{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:.86rem;color:var(--pmute)}
.tags span{display:inline-flex;align-items:center;gap:7px}
.tags span::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--k,var(--base));border:1.5px solid var(--base)}
.k-ai{--k:var(--blue)}.k-data{--k:var(--base)}.k-web{--k:transparent}
.yr{color:var(--pmute);font-variant-numeric:tabular-nums;font-size:.9rem}
.plus{position:relative;width:18px;height:18px;transition:transform .45s var(--ease)}
.plus::before,.plus::after{content:"";position:absolute;inset:50% 0 auto;height:2px;background:var(--base);margin-top:-1px}
.plus::after{transform:rotate(90deg)}
.row-h[aria-expanded=true] .plus{transform:rotate(135deg)}
.row .box{inset:-1px -6px}
.row-h:hover~.box,.row-h:focus-visible~.box,.row.act .box{opacity:1;transform:none}
.row-b{display:grid;grid-template-rows:0fr;visibility:hidden;transition:grid-template-rows .5s var(--ease),visibility 0s .5s}
.row-h[aria-expanded=true]+.row-b{grid-template-rows:1fr;visibility:visible;transition-delay:0s}
.row-b>div{overflow:hidden}
.detail{display:grid;gap:14px;padding:2px 4px 26px}
.detail p{font-size:1.05rem;max-width:40ch}
.detail ul{display:grid;gap:10px}
.detail li{padding-left:22px;position:relative}
.detail li::before{content:"";position:absolute;left:0;top:.72em;width:10px;height:2px;background:var(--blue)}
.detail a{display:inline-block;font-weight:600;text-decoration:none;border-bottom:3px solid var(--blue);padding-bottom:1px}
.detail a:hover{background:var(--base);color:var(--alt);border-color:var(--base)}
.fact{display:inline-block;padding:5px 10px;border:1px solid var(--pline);font-size:.9rem;color:var(--pmute);justify-self:start}

/* ---------- results ---------- */
.res{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(28px,6vw,96px);align-items:start}
.res .lead2{font-size:1.2rem;max-width:30rem}
.res .note{margin-top:18px;color:var(--mute);max-width:30rem}
.plot{--rh:78px;display:grid;grid-template-columns:minmax(0,11rem) minmax(0,1fr) 4.6rem;border-top:1px solid var(--line2)}
.plot .c{display:grid;grid-auto-rows:var(--rh)}
.names>div{display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid var(--line);line-height:1.25;font-weight:500;padding-right:10px}
.names small{color:var(--mute);font-weight:400;font-size:.8rem;font-variant-numeric:tabular-nums}
#st-res{position:relative;height:calc(var(--rh)*4);background:repeating-linear-gradient(to bottom,transparent 0 calc(var(--rh) - 1px),var(--line) calc(var(--rh) - 1px) var(--rh))}
#st-res::before{content:"";position:absolute;left:83.33%;top:0;bottom:0;border-left:2px dashed var(--blue)}
#st-res .better{position:absolute;left:calc(83.33% + 8px);top:6px;color:var(--mute)}
.vals>span{display:flex;align-items:center;justify-content:flex-end;border-bottom:1px solid var(--line);font-weight:700;font-variant-numeric:tabular-nums}
.axis{grid-column:1/-1;padding:0 0 12px;color:var(--mute);order:-1}
.plot .fig{grid-column:1/-1}
.fact2{display:inline-block;margin-top:18px;padding:6px 11px;border:1px solid var(--line2);color:var(--mute);font-size:.92rem}

/* ---------- lab ---------- */
.lab{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,4.5vw,72px);align-items:stretch}
.lab .panel h3{font-size:1.6rem;line-height:1.1;font-weight:800;font-stretch:112%;letter-spacing:-.025em;margin:10px 0 8px}
.tag{display:inline-block;padding:3px 10px;border:1px solid var(--pline);border-radius:99px;font-size:.82rem;color:var(--pmute)}
.items{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.item{padding:14px 14px;text-align:left;border:1px solid var(--pline);background:transparent;cursor:pointer;font-weight:500;transition:border-color .2s,background .2s,color .2s,transform .25s var(--ease)}
.item:hover{border-color:var(--base)}
.item:active{transform:scale(.97)}
.item[aria-pressed=true]{background:var(--base);color:var(--alt);border-color:var(--base)}
.verdict{margin-top:18px;min-height:4.6em;font-size:.98rem}
.note2{font-size:.82rem;color:var(--pmute);margin-top:6px}
#st-lab{height:min(44vh,330px)}
.probs{display:grid;grid-template-columns:repeat(3,1fr);column-gap:max(10px,4%);margin-top:12px;text-align:center}
.probs b{display:block;font-weight:600}
.probs span{color:var(--mute);font-variant-numeric:tabular-nums}
.probs .win span{color:var(--alt);font-weight:700}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:clamp(20px,3vw,32px)}
.card{display:block;text-decoration:none;position:relative;border:1px solid var(--line2);padding:clamp(18px,2.6vw,28px);transition:background .3s,color .3s,border-color .3s}
.card:hover{background:var(--alt);color:var(--base);border-color:var(--alt)}
.card:hover p,.card:hover .tag{color:var(--pmute);border-color:var(--pline)}
.card:hover .box{opacity:1;transform:none}
.card h3{font-size:1.35rem;line-height:1.15;font-weight:800;font-stretch:112%;letter-spacing:-.02em;margin:12px 0 6px}
.card p{color:var(--mute)}
.card .tag{color:var(--mute);border-color:var(--line2)}

/* ---------- about ---------- */
.about{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,6vw,96px);align-items:center}
.lensbtn{position:relative;display:block;width:100%;text-align:left;background:none;border:0;border-top:1px solid var(--line2);padding:22px 28px 22px 0;cursor:pointer}
.lensbtn:last-of-type{border-bottom:1px solid var(--line2)}
.lensbtn h3{font-size:clamp(1.7rem,3.6vw,2.8rem);line-height:1;font-weight:800;font-stretch:125%;letter-spacing:-.035em;color:var(--mute);transition:color .3s}
.lensbtn:hover h3,.lensbtn[aria-pressed=true] h3{color:var(--alt)}
.lensbtn .ex{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s var(--ease)}
.lensbtn[aria-pressed=true] .ex{grid-template-rows:1fr}
.lensbtn .ex>p{overflow:hidden;color:var(--mute);max-width:34rem}
.lensbtn[aria-pressed=true] .ex>p{padding-top:12px}
.lensbtn::after{content:"";position:absolute;right:2px;top:30px;width:12px;height:12px;background:var(--blue);transform:scale(0);transition:transform .35s var(--ease)}
.lensbtn[aria-pressed=true]::after{transform:scale(1)}
#st-about{height:min(50vh,430px)}
.strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin-top:clamp(40px,6vw,80px)}
.strip>div{padding:6px 22px 6px 0}
.strip>div+div{padding-left:22px;border-left:1px solid var(--pline)}
.strip small{display:block;color:var(--pmute);font-size:.85rem}
.strip b{display:block;font-size:1.1rem;line-height:1.25;font-weight:700;font-stretch:112%;margin:4px 0}

/* ---------- stack ---------- */
.stack{display:grid;border-top:1px solid var(--line2)}
.stack>div{display:grid;grid-template-columns:minmax(0,14rem) 1fr;gap:20px;padding:24px 0;border-bottom:1px solid var(--line2)}
.stack dt{font-size:1.1rem;font-weight:700;font-stretch:112%}
.stack dd{display:flex;flex-wrap:wrap;gap:8px}
.stack dd span{padding:7px 14px;border:1px solid var(--line2);border-radius:99px;font-weight:500;background:color-mix(in srgb,var(--base) 70%,transparent);transition:background .2s,color .2s,border-color .2s,transform .25s var(--ease)}
.stack dd span:hover{transform:translateY(-2px);background:var(--alt);color:var(--base);border-color:var(--blue)}

/* ---------- contact (30% band) + footer ---------- */

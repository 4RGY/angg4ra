    for (let i = 0; i < N; i++) dots.push({
      x: rnd() * W, y: rnd() * H, vx: 0, vy: 0, tx: 0, ty: 0, lx: 0, ly: 0, t0: 0, ph: rnd() * 6.283, z: .5 + rnd(),
      ax: rnd() * W, ay: rnd() * H, on: 0, a: .3, at: .3, sz: .6, am: 1, c: 0, cT: 0, cN: 0, cAt: 0, pend: false, pulse: 0, big: 0, dx: 0, dy: 0, dr: 0, inn: 0
    });
  };

  const retarget = (now, first) => {
    for (const d of dots) { d.on = 0; d.at = .2; d.t0 = now + rnd() * .25; d.cN = 0; d.cAt = now + .1; d.pend = true; }
    if (cur === 'ambient') { S.rT = 2.1; return; }
    const g = getStage(cur), r = rects[cur];
    S.rT = clamp(g.g * .42, 1.3, 4.2);
    const order = dots.slice().sort((a, b) => a.x - b.x || a.y - b.y);
    const pts = g.pts.slice().sort((a, b) => a.x - b.x || a.y - b.y);
    const P = pts.length, K = Math.min(P, N);
    for (let i = 0; i < K; i++) {
      const d = order[Math.floor(i * N / K)], p = pts[Math.floor(i * P / K)];
      d.on = 1; d.at = .95; d.lx = p.x; d.ly = p.y; d.cN = p.k;
      d.t0 = now + clamp(p.x / Math.max(1, r.width), 0, 1) * .45 + rnd() * .08;
      d.cAt = d.t0 + .3 + (first ? 1.3 : 0);
    }
  };

  const pick = () => {
    const lo = H * .28, hi = H * .72; let best = 'ambient', bo = 0;
    const ov = r => Math.max(0, Math.min(r.bottom, hi) - Math.max(r.top, lo));
    for (const k in stages) { const o = ov(rects[k]); if (o > bo) { bo = o; best = k; } }
    if (cur !== 'ambient' && ov(rects[cur]) > 16 && bo < ov(rects[cur]) * 1.25 + 30) return cur;
    return bo > 40 ? best : 'ambient';
  };

  /* ---- one frame ---- */
  const step = (dt, now) => {
    for (const k in stages) rects[k] = stages[k].getBoundingClientRect();
    const nx = hold ? 'ambient' : pick();
    if (nx !== cur) { cur = nx; retarget(now, introPending && cur === 'name'); if (cur === 'name') introPending = false; needRetarget = false; }
    else if (needRetarget) { needRetarget = false; retarget(now, false); }

    /* lens: follows the pointer, drifts by itself over the name when nobody is moving */
    const pnow = performance.now(), idle = pnow - lastMove > 2800;
    if (idle) {
      if (cur === 'name' && !reduce) {
        const r = rects.name; lens.tx = r.left + r.width * (.5 + .36 * Math.sin(now * .5)); lens.ty = r.top + r.height * (.5 + .3 * Math.sin(now * .7 + 1)); S.laT = 1;
      } else S.laT = 0;
    } else S.laT = seen ? 1 : 0;
    if (reduce) { S.la = S.laT; lens.x = lens.tx; lens.y = lens.ty; S.r = S.rT; }
    else { S.la = S.la + (S.laT - S.la) * (1 - Math.exp(-4 * dt)); lens.x += (lens.tx - lens.x) * (1 - Math.exp(-12 * dt)); lens.y += (lens.ty - lens.y) * (1 - Math.exp(-12 * dt)); S.r += (S.rT - S.r) * (1 - Math.exp(-5 * dt)); }

    const f = Math.min(2, dt * 60), R = lens.R, R2 = R * R, la = S.la, sr = rects[cur] || null;
    const ox = sr ? sr.left : 0, oy = sr ? sr.top : 0, sy = scrollY, cnt = [0];
    for (const d of dots) {
      if (d.on) { d.tx = d.lx + ox; d.ty = d.ly + oy; } else { d.tx = d.ax; d.ty = d.ay + Math.sin(sy * .0015 + d.ph) * 28 * d.z; }
      if (reduce) { d.x = d.tx; d.y = d.ty; }
      else if (now >= d.t0) {
        d.vx += (d.tx - d.x) * .08 * f; d.vy += (d.ty - d.y) * .08 * f;
        const k = Math.pow(.8, f); d.vx *= k; d.vy *= k; d.x += d.vx * f; d.y += d.vy * f;
      }
      if (d.pend && now >= d.cAt) { d.pend = false; if (d.cN !== d.cT) { d.cT = d.cN; if (d.cT) d.pulse = 1; } }
      const r1 = Math.min(1, dt * 7);
      d.c += (d.cT - d.c) * r1; d.a += (d.at - d.a) * r1; d.sz += ((d.on ? 1 : .6) - d.sz) * r1; d.am += ((d.on ? 0 : 1) - d.am) * Math.min(1, dt * 3);
      d.pulse = Math.max(0, d.pulse - dt * 2.2);
      const amp = reduce ? 0 : .8 + 11 * d.am;
      const px = d.x + Math.sin(now * .6 + d.ph) * amp, py = d.y + Math.cos(now * .5 + d.ph) * amp;
      const lx = px - lens.x, ly = py - lens.y, q = lx * lx + ly * ly; let inside = 0;
      if (la > .02 && q < R2) { const k = 1 + .5 * la * (1 - q / R2); d.dx = lens.x + lx * k; d.dy = lens.y + ly * k; inside = 1; cnt[0]++; }
      else { d.dx = px; d.dy = py; }
      d.big += (inside - d.big) * Math.min(1, reduce ? 1 : dt * 14);
      d.dr = S.r * d.sz * (1 + .8 * d.big) * (1 + .9 * d.pulse * d.c); d.inn = d.big > .5 ? 1 : 0;
    }

    /* draw, batched by colour and opacity */
    ctx.clearRect(0, 0, W, H);
    const B = bufs; for (let i = 0; i < 8; i++) B[i].length = 0;
    for (const d of dots) {
      if (d.dx < -10 || d.dx > W + 10 || d.dy < -10 || d.dy > H + 10) continue;
      const a = d.inn ? 1 : d.a;
      B[(d.c > .5 ? 4 : 0) + (a < .25 ? 0 : a < .47 ? 1 : a < .75 ? 2 : 3)].push(d);
    }
    const lv = [.16, .34, .62, .95], rr = typeof ctx.roundRect === 'function';
    for (let b = 0; b < 8; b++) {
      const arr = B[b]; if (!arr.length) continue;
      ctx.globalAlpha = b > 3 ? Math.max(.7, lv[b & 3]) : lv[b & 3]; ctx.fillStyle = b > 3 ? blueCss : altCss; ctx.beginPath();
      for (const d of arr) { const r = d.dr; if (rr) ctx.roundRect(d.dx - r, d.dy - r, r * 2, r * 2, r * .55); else { ctx.moveTo(d.dx + r, d.dy); ctx.arc(d.dx, d.dy, r, 0, 6.2832); } }
      ctx.fill();
    }
    /* the lens: crosshair, ring and a live readout */
    if (la > .02) {
      ctx.strokeStyle = blueCss; ctx.lineWidth = 1; ctx.setLineDash([4, 6]);
      ctx.globalAlpha = la * .32; ctx.beginPath(); ctx.moveTo(0, lens.y); ctx.lineTo(W, lens.y); ctx.moveTo(lens.x, 0); ctx.lineTo(lens.x, H); ctx.stroke(); ctx.setLineDash([]);
      ctx.globalAlpha = la * .06; ctx.fillStyle = blueCss; ctx.beginPath(); ctx.arc(lens.x, lens.y, R, 0, 6.2832); ctx.fill();
      ctx.globalAlpha = la * .95; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(lens.x, lens.y, R, 0, 6.2832); ctx.stroke();
      ctx.beginPath(); for (const [a, b] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) { ctx.moveTo(lens.x + a * (R - 6), lens.y + b * (R - 6)); ctx.lineTo(lens.x + a * (R + 9), lens.y + b * (R + 9)); } ctx.stroke();
      ctx.globalAlpha = la * .9; ctx.fillStyle = altCss; ctx.font = `500 12px ${FAM}`;
      const label = `x ${String(lens.x | 0).padStart(4, '0')}  y ${String((lens.y + sy) | 0).padStart(4, '0')}  ${cnt[0]} ${tx('dim_s') || ''}`;
      const tw = ctx.measureText(label).width, side = lens.x + R + 14 + tw > W - 10 ? -1 : 1;
      ctx.textAlign = side > 0 ? 'left' : 'right'; ctx.fillText(label, lens.x + side * (R + 14), lens.y - R * .15);
    }
    ctx.globalAlpha = 1;
  };
  const bufs = Array.from({ length: 8 }, () => []);

  const loop = t => {
    raf = 0; if (document.hidden) return;
    const now = t / 1000, dt = Math.min(.05, now - (last || now - .016)); last = now;
    const calm = !reduce && cur !== 'name' && performance.now() - lastMove > 6000 && performance.now() - lastScroll > 2500;
    if (!(calm && (tick2++ & 1))) step(dt, now);
    raf = requestAnimationFrame(loop);
  };
  const kick = () => { if (!raf && inited && !document.hidden) { last = 0; raf = requestAnimationFrame(loop); } };
  document.addEventListener('visibilitychange', kick);

  const measure = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    const nW = innerWidth, nH = innerHeight, bucket = n => n < 700 ? 0 : n < 1100 ? 1 : 2, rebuild = !dots.length || bucket(nW) !== bucket(W);
    W = nW; H = nH; cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (rebuild) buildDots();
    lens.R = W < 700 ? 78 : 118; cache = {};
    $('#dimN').textContent = `${N.toLocaleString(lang === 'id' ? 'id-ID' : 'en-US')} ${tx('dim_s')}`;
  };
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { if (!inited) return; measure(); needRetarget = true; kick(); }, 150); });

  const at = e => { lens.tx = e.clientX; lens.ty = e.clientY; lastMove = performance.now(); if (!seen) { seen = true; lens.x = lens.tx; lens.y = lens.ty; } };
  addEventListener('pointermove', at, { passive: true }); addEventListener('pointerdown', at, { passive: true });
  document.addEventListener('pointerleave', () => { lastMove = performance.now() - 1500; });
  onTheme = () => { readColors(); };

  /* =============== work: accordion, filter, project stage =============== */
  const rows = $$('.row'), heads = $$('.row-h'), chips = $$('.chip');
  const capProj = $('#cap-proj'), capAbout = $('#cap-about');
  const setProj = i => {
    if (KEY.proj === i && capProj.textContent) return;
    KEY.proj = i; capProj.textContent = tx('c_p' + (i + 1));
    rows.forEach((r, j) => r.classList.toggle('act', j === i));
    if (cur === 'proj') needRetarget = true;
  };
  rows.forEach((r, i) => {
    const h = $('.row-h', r);
    h.addEventListener('pointerenter', () => setProj(i));
    h.addEventListener('focus', () => setProj(i));
    h.addEventListener('click', () => {
      const open = h.getAttribute('aria-expanded') === 'true';
      heads.forEach(x => x.setAttribute('aria-expanded', 'false'));
      h.setAttribute('aria-expanded', String(!open)); setProj(i);
    });
  });
  chips.forEach(c => {
    const f = c.dataset.f;
    $('.n', c).textContent = f === 'all' ? rows.length : rows.filter(r => r.dataset.cat.split(' ').includes(f)).length;
    c.addEventListener('click', () => {
      chips.forEach(x => x.setAttribute('aria-pressed', String(x === c)));
      const change = () => {
        rows.forEach(r => { r.hidden = !(f === 'all' || r.dataset.cat.split(' ').includes(f)); });
        if (rows[KEY.proj].hidden) { const first = rows.findIndex(r => !r.hidden); if (first >= 0) { KEY.proj = -1; setProj(first); } }
      };
      if (document.startViewTransition && !reduce) {
        rows.forEach((r, i) => r.style.viewTransitionName = 'row' + i);
        document.startViewTransition(change).finished.finally(() => rows.forEach(r => r.style.viewTransitionName = ''));
      } else change();
    });
  });

  /* =============== results: numbers count up when the plot arrives =============== */
  const vals = $$('#vals span');
  new IntersectionObserver((es, ob) => {
    if (!es[0].isIntersecting) return; ob.disconnect();
    vals.forEach((el, i) => {
      const target = parseFloat(el.dataset.d);
      if (reduce) { el.textContent = target.toFixed(4); return; }
      const t0 = performance.now() + i * 140, dur = 1000;
      const stp = t => { const p = clamp((t - t0) / dur, 0, 1), e = 1 - Math.pow(1 - p, 3); el.textContent = (target * e).toFixed(4); if (p < 1) requestAnimationFrame(stp); };
      requestAnimationFrame(stp);
    });
  }, { threshold: .4 }).observe($('#plot'));

  /* =============== lab: waste sorter drives the dot columns =============== */
  const items = $$('.item'), probs = $$('#probs > div'), verdict = $('#verdict');
  const show = k => {
    const p = PROB[k], max = Math.max(...p);
    items.forEach(i => i.setAttribute('aria-pressed', String(i.dataset.k === k)));
    probs.forEach((el, i) => { $('span', el).textContent = Math.round(p[i] * 100) + '%'; el.classList.toggle('win', p[i] === max); });
    verdict.textContent = tx('v_' + k);
    KEY.lab = k; if (cur === 'lab') needRetarget = true;
  };
  items.forEach(i => i.addEventListener('click', () => show(i.dataset.k)));

  /* =============== about: three lenses, same dots =============== */
  const lensBtns = $$('.lensbtn');
  const setLens = i => {
    lensBtns.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
    KEY.about = i; capAbout.textContent = tx('ab_cap_' + i); if (cur === 'about') needRetarget = true;
  };
  lensBtns.forEach((b, i) => { b.addEventListener('pointerenter', () => setLens(i)); b.addEventListener('focus', () => setLens(i)); b.addEventListener('click', () => setLens(i)); });

  /* =============== contact: copy =============== */
  const toast = $('#toast'); let tt;
  const say = m => { toast.textContent = m; toast.classList.add('show'); clearTimeout(tt); tt = setTimeout(() => toast.classList.remove('show'), 1800); };
  $('#copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText('rgyanggara@gmail.com'); say(tx('toast_ok')); }
    catch (e) { say(tx('toast_fail')); }
  });

  onLang = () => {
    capProj.textContent = tx('c_p' + (KEY.proj + 1)); capAbout.textContent = tx('ab_cap_' + KEY.about);
    verdict.textContent = tx('v_' + KEY.lab);
    if (inited) $('#dimN').textContent = `${N.toLocaleString(lang === 'id' ? 'id-ID' : 'en-US')} ${tx('dim_s')}`;
  };
  applyLang(); setProj(0); show('bottle'); setLens(0);

  /* =============== intro: scatter, then the name assembles and the period lands in blue =============== */
  const start = () => {
    for (const k in stages) rects[k] = stages[k].getBoundingClientRect();
    measure(); inited = true;
    dots.forEach(d => { d.x = d.ax; d.y = d.ay; });
    if (reduce) { hold = false; root.classList.add('ready'); hero.classList.add('go'); }
    else {
      setTimeout(() => { hold = false; }, 450);
      setTimeout(() => hero.classList.add('go'), 1500);
      setTimeout(() => root.classList.add('ready'), 2100);
    }
    kick();
  };
  const fontsReady = document.fonts
    ? Promise.race([document.fonts.load('800 100px Archivo').catch(() => 0), new Promise(r => setTimeout(r, 1500))]) : Promise.resolve();
  fontsReady.then(start);
  if (document.fonts) document.fonts.ready.then(() => { if (inited) { cache = {}; needRetarget = true; } });

  console.log('%cangg4ra.%c designed and built this.', 'background:#2b5bff;color:#d9dce1;padding:3px 8px;font-weight:700', '');
})();
</script>
</body>
</html>

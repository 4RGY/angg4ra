---
import id from '../../i18n/id/ui.json';
import en from '../../i18n/en/ui.json';
const { lang = 'id' } = Astro.props;
const t = lang === 'id' ? id : en;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <a class="footer-name" href={`/${lang}/`}>Argy Anggara<span aria-hidden="true">.</span></a>
      <p class="footer-edition font-mono">MIDNIGHT ARCTIC</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={`/${lang}/#projects`}>{t.nav.projects}</a>
      <a href={`/${lang}/#contact`}>{t.nav.contact}</a>
      <a href="https://github.com/4RGY" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://linkedin.com/in/argy-anggara" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="footer-bottom">
      <p>© {year} Argy Anggara</p>
      <a href="mailto:rgyanggara@gmail.com">rgyanggara@gmail.com <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); margin-top: clamp(4rem, 9vw, 7rem); padding: 3rem 0 1.5rem; position: relative; }
  /* Keep the fixed homepage scene visible; only the closing edge gets a scrim. */
  :global(body[data-dive='true']) .footer::before { content: ''; position: absolute; inset: -3rem 0 0; background: linear-gradient(0deg, var(--bg-main), transparent); opacity: 0.7; pointer-events: none; }
  .footer-inner { max-width: var(--shell-width); margin: 0 auto; padding: 0 var(--shell-gutter); display: grid; grid-template-columns: 1fr auto; gap: 2.5rem; align-items: center; position: relative; z-index: 1; }
  .footer-name { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.45rem; letter-spacing: -0.045em; font-weight: 500; color: var(--text-primary); }
  .footer-name span { color: var(--accent); }
  .footer-edition { margin-top: 0.3rem; font-size: 0.58rem; letter-spacing: 0.18em; color: var(--text-secondary); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .footer-links a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; font-size: 0.8rem; color: var(--text-secondary); }
  .footer-links a span { color: var(--accent-data); font-size: 0.7rem; }
  .footer-bottom { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; font-size: 0.7rem; }
  .footer-bottom a { color: var(--text-secondary); min-height: 44px; display: inline-flex; align-items: center; gap: 0.5rem; overflow-wrap: anywhere; }
  .footer a:hover { color: var(--hover); }
  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .footer-links { gap: 0.25rem 1.25rem; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>

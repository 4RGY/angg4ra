---
import LanguageToggle from '../ui/LanguageToggle.astro';
import id from '../../i18n/id/ui.json';
import en from '../../i18n/en/ui.json';

const { lang = 'id', currentPath = '' } = Astro.props;
const t = lang === 'id' ? id : en;
const path = currentPath.replace(/\/+$/, '') || '/';
const navLinks = ['projects', 'blog', 'misc', 'contact'].map(section => ({
  href: `/${lang}/${section}/`,
  label: t.nav[section as keyof typeof t.nav],
  active: path === `/${lang}/${section}` || path.startsWith(`/${lang}/${section}/`),
}));
---

<nav class="navbar" aria-label={lang === 'id' ? 'Navigasi utama' : 'Primary navigation'}>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
  <div class="nav-inner">
    <a href={`/${lang}/`} class="nav-logo" aria-label="Argy Anggara" aria-current={path === `/${lang}` ? 'page' : undefined}>
      <span class="nav-wordmark">anggara<span class="nav-wordmark-dot">.</span></span>
      <span class="nav-signature font-mono" aria-hidden="true">MIDNIGHT ARCTIC</span>
    </a>

    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? (path === link.href.slice(0, -1) ? 'page' : 'true') : undefined}>{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-right">
      <LanguageToggle currentLang={lang} currentPath={currentPath} />
      <details class="mobile-nav" id="mobile-nav">
        <summary class="hamburger" id="hamburger" aria-controls="mobile-menu" aria-label={lang === 'id' ? 'Menu navigasi' : 'Navigation menu'}>
          <span class="ham-line" aria-hidden="true"></span>
          <span class="ham-line" aria-hidden="true"></span>
        </summary>
        <div class="mobile-menu" id="mobile-menu">
          <ul class="mobile-links">
            {navLinks.map((link, index) => (
              <li><a href={link.href} class:list={['mobile-link', { active: link.active }]} aria-current={link.active ? (path === link.href.slice(0, -1) ? 'page' : 'true') : undefined}>
                <span class="mobile-index font-mono" aria-hidden="true">0{index + 1}</span>
                <span>{link.label}</span><span class="mobile-arrow" aria-hidden="true">↗</span>
              </a></li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  const progressBar = document.getElementById('scroll-progress');
  function updateProgress() {
    const distance = document.documentElement.scrollHeight - window.innerHeight;
    const progress = distance > 0 ? Math.min(1, Math.max(0, window.scrollY / distance)) : 0;
    if (progressBar) progressBar.style.transform = `scaleX(${progress})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  window.addEventListener('load', updateProgress);
  updateProgress();

  // Native disclosure remains usable without JavaScript. No body scroll lock:
  // closing or crossing a breakpoint must never strand the dive/page scroll.
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-nav');
  const trigger = document.getElementById('hamburger');
  menu?.addEventListener('toggle', () => {
    trigger?.setAttribute('aria-expanded', String(menu.open));
  });
  trigger?.setAttribute('aria-expanded', String(menu?.open ?? false));
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => { menu.open = false; });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      trigger?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  document.addEventListener('focusin', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  window.matchMedia('(min-width: 801px)').addEventListener('change', event => {
    if (event.matches && menu) menu.open = false;
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
  }
  .scroll-progress {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  .nav-inner {
    max-width: var(--shell-width);
    min-height: 76px;
    margin: 0 auto;
    padding: 0 var(--shell-gutter);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .nav-logo { display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; min-height: 48px; color: var(--text-primary); }
  .nav-wordmark { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.065em; line-height: 1.15; }
  .nav-wordmark-dot { color: var(--accent); }
  .nav-signature { margin-top: 0.25rem; font-size: 0.5rem; letter-spacing: 0.16em; color: var(--text-secondary); }
  .nav-logo:hover .nav-wordmark { color: var(--hover); }
  .nav-links { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); list-style: none; margin-left: auto; }
  .nav-link { position: relative; display: flex; align-items: center; min-height: 48px; font-size: 0.84rem; color: var(--text-secondary); }
  .nav-link::after { content: ''; position: absolute; inset: auto 0 4px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 200ms ease; }
  .nav-link:hover, .nav-link.active { color: var(--text-primary); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .nav-right { display: flex; align-items: center; gap: 1rem; }
  .nav-right :global(.lang-toggle) { gap: 0.35rem; font-size: 0.68rem; }
  .nav-right :global(.lang-toggle a) { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 44px; }
  .mobile-nav { display: none; }
  .hamburger { width: 44px; height: 44px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; cursor: pointer; list-style: none; border: 1px solid var(--border); border-radius: 50%; }
  .hamburger::-webkit-details-marker { display: none; }
  .hamburger::marker { content: ''; }
  .hamburger:hover { background: var(--bg-elevated); }
  .hamburger:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .ham-line { width: 17px; height: 1px; background: var(--text-primary); transition: transform 200ms ease; }
  .mobile-nav[open] .ham-line:first-child { transform: translateY(3.5px) rotate(45deg); }
  .mobile-nav[open] .ham-line:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .mobile-menu { position: absolute; top: 100%; left: 0; right: 0; background: var(--bg-main); border-bottom: 1px solid var(--border); max-height: calc(100dvh - 68px); overflow-y: auto; overscroll-behavior: contain; box-shadow: 0 20px 32px color-mix(in srgb, var(--bg-main) 65%, transparent); }
  .mobile-links { list-style: none; padding: 0.5rem var(--shell-gutter) 1.25rem; }
  .mobile-links li + li { border-top: 1px solid var(--border); }
  .mobile-link { display: flex; align-items: center; gap: 1rem; min-height: 64px; color: var(--text-secondary); font-size: 1.15rem; }
  .mobile-index { color: var(--text-secondary); font-size: 0.6rem; }
  .mobile-arrow { margin-left: auto; font-size: 1rem; }
  .mobile-link:hover, .mobile-link.active { color: var(--accent); }
  @media (max-width: 800px) {
    .nav-inner { min-height: 68px; gap: 0.75rem; }
    .nav-links { display: none; }
    .nav-right { margin-left: auto; gap: 0.65rem; }
    .mobile-nav { display: block; }
  }
</style>

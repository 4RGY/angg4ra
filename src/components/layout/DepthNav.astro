---
// DepthNav (v15, Opsi A) — dive-rail kanan. Overlay penuh: nggak nambah
// tinggi dokumen. Brand di kiri atas, ID/EN sejajar di kanan atas,
// rel kedalaman + readout meter di kanan tengah.
const { lang = 'id' } = Astro.props;
const id = lang === 'id';
const stops = [
  { sel: '#surface',  label: id ? 'Permukaan' : 'Surface',  m: '0m' },
  { sel: '#about',    label: id ? 'Tentang' : 'About',      m: '20m' },
  { sel: '#projects', label: id ? 'Karya' : 'Work',         m: '200m' },
  { sel: '#notes',    label: id ? 'Tulisan' : 'Writing',    m: '800m' },
  { sel: '#contact',  label: id ? 'Kontak' : 'Contact',     m: '4000m' },
];
---
<a class="dn-brand" href={`/${lang}/`}>anggara<span aria-hidden="true">.</span></a>

<div class="dn-lang" aria-label={id ? 'Ganti bahasa' : 'Switch language'}>
  {id
    ? <><b>ID</b><span aria-hidden="true"> / </span><a href="/en/" lang="en" hreflang="en">EN</a></>
    : <><a href="/id/" lang="id" hreflang="id">ID</a><span aria-hidden="true"> / </span><b>EN</b></>}
</div>

<nav class="dive-rail" aria-label={id ? 'Navigasi kedalaman' : 'Depth navigation'}>
  <ul class="dr-stops">
    {stops.map((s, i) => (
      <li>
        <a href={s.sel} data-rail-stop={s.sel} aria-current={i === 0 ? 'true' : undefined}>
          <span class="dr-text">{s.label}<em>· {s.m}</em></span>
          <i aria-hidden="true"></i>
        </a>
      </li>
    ))}
  </ul>
  <div class="dr-bar" aria-hidden="true"><span class="dr-fill" data-rail-fill></span></div>
</nav>

<p class="dr-readout" aria-hidden="true" data-rail-readout>0 m</p>

<script>
  const stops = [...document.querySelectorAll('[data-rail-stop]')];
  const fill = document.querySelector('[data-rail-fill]');
  const readout = document.querySelector('[data-rail-readout]');
  const targets = stops.map((a) => document.querySelector(a.dataset.railStop));

  stops.forEach((a, i) => a.addEventListener('click', (e) => {
    const el = targets[i];
    if (!el) return;
    e.preventDefault();
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  let queued = false;
  const paint = () => {
    queued = false;
    const range = document.documentElement.scrollHeight - window.innerHeight;
    const p = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
    if (fill) fill.style.height = (p * 100).toFixed(2) + '%';
    if (readout) {
      const m = Math.round(p * 4000);
      readout.textContent = (m ? '−' : '') + m.toLocaleString('id-ID') + ' m';
    }
    // stop aktif = target terakhir yang tepinya sudah lewat 45% viewport
    const line = window.innerHeight * 0.45;
    let active = 0;
    targets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= line) active = i; });
    stops.forEach((a, i) => {
      if (i === active) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
  addEventListener('resize', paint, { passive: true });
  paint();
</script>

<style>
  .dn-brand,
  .dn-lang,
  .dive-rail,
  .dr-readout { position: fixed; z-index: 50; }

  .dn-brand {
    top: 1.4rem;
    left: max(1.5rem, calc((100vw - 1160px) / 2));
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -.05em;
    line-height: 1;
    color: var(--text-primary);
    text-decoration: none;
    text-shadow: 0 2px 18px rgba(2, 8, 16, .85);
  }
  .dn-brand span { color: var(--accent); }
  .dn-brand:hover { color: var(--hover); }

  .dn-lang {
    top: 1.5rem;
    right: max(1.25rem, calc((100vw - 1160px) / 2));
    font-family: var(--font-mono);
    font-size: .66rem;
    letter-spacing: .1em;
    color: var(--text-muted);
    text-shadow: 0 2px 18px rgba(2, 8, 16, .85);
  }
  .dn-lang b { color: var(--text-primary); font-weight: 500; }
  .dn-lang a { color: var(--text-muted); text-decoration: none; }
  .dn-lang a:hover { color: var(--accent); }

  /* ── rel kanan ─────────────────────────────────────────── */
  .dive-rail {
    top: 50%;
    right: max(1.1rem, calc((100vw - 1240px) / 2));
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: .75rem;
  }
  .dr-stops { display: flex; flex-direction: column; align-items: flex-end; gap: .95rem; list-style: none; margin: 0; padding: 0; }
  .dr-stops a {
    display: flex;
    align-items: center;
    gap: .6rem;
    text-decoration: none;
    padding: .15rem 0;
  }
  .dr-text {
    font-family: var(--font-mono);
    font-size: .6rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    transition: color .3s ease;
  }
  .dr-text em { font-style: normal; color: inherit; opacity: .6; margin-left: .3em; }
  .dr-stops i {
    display: block;
    width: 16px; height: 1px;
    background: rgba(230, 238, 247, .3);
    transition: width .35s cubic-bezier(.16,1,.3,1), background .3s ease, box-shadow .3s ease;
  }
  .dr-stops a:hover .dr-text { color: var(--text-secondary); }
  .dr-stops a:hover i { width: 26px; background: var(--text-primary); }
  .dr-stops a:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  .dr-stops a[aria-current] .dr-text { color: var(--text-primary); }
  .dr-stops a[aria-current] i {
    width: 30px;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(86, 200, 232, .75);
  }

  .dr-bar { width: 2px; height: 132px; background: rgba(230, 238, 247, .12); border-radius: 2px; overflow: hidden; }
  .dr-fill { display: block; width: 100%; height: 0%; background: linear-gradient(180deg, var(--accent), #2b6cb0); will-change: height; }

  .dr-readout {
    right: max(1.1rem, calc((100vw - 1240px) / 2));
    bottom: 1.3rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: .62rem;
    letter-spacing: .08em;
    color: var(--text-muted);
    text-shadow: 0 2px 18px rgba(2, 8, 16, .85);
  }

  @media (max-width: 900px) {
    .dr-text { display: none; }
    .dive-rail { gap: .5rem; }
  }
  @media (max-width: 640px) {
    .dr-bar { height: 96px; }
    .dn-brand { font-size: .95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dr-stops i, .dr-text { transition: none; }
  }
</style>

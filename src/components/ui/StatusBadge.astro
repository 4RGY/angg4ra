---
// status: 'Selesai' | 'Sedang Berjalan' | 'Berkelanjutan' | 'Completed' | 'In Progress' | 'Ongoing'
const { status } = Astro.props;

const styles = {
  'Selesai':          { dot: '#6b8fd4', label: 'Selesai' },
  'Sedang Berjalan':  { dot: '#4aa8c9', label: 'Sedang Berjalan' },
  'Berkelanjutan':    { dot: '#56c8e8', label: 'Berkelanjutan' },
  'Completed':        { dot: '#6b8fd4', label: 'Completed' },
  'In Progress':      { dot: '#4aa8c9', label: 'In Progress' },
  'Ongoing':          { dot: '#56c8e8', label: 'Ongoing' },
}[status] || { dot: '#7A756A', label: status };
---

<span class="status-badge">
  <span class="dot" style={`background: ${styles.dot}`}></span>
  {styles.label}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
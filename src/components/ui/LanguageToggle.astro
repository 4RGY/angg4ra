---
const { currentLang, currentPath } = Astro.props;
const otherLang = currentLang === 'id' ? 'en' : 'id';

function localizedPath(path: string) {
  const normalized = path.replace(/\/$/, '');
  const detailMatch = normalized.match(/^\/(id|en)\/(projects|blog)\/([^/]+)$/);
  if (detailMatch) {
    const [, , section, slug] = detailMatch;
    const localizedSlug = otherLang === 'en'
      ? (slug.endsWith('-en') ? slug : `${slug}-en`)
      : slug.replace(/-en$/, '');
    return `/${otherLang}/${section}/${localizedSlug}/`;
  }

  const switched = normalized.replace(new RegExp(`^/${currentLang}(?=/|$)`), `/${otherLang}`);
  const fallback = `/${otherLang}`;
  return `${switched || fallback}/`;
}

const otherPath = localizedPath(currentPath);
---

<div class="lang-toggle" aria-label="Language selection">
  {currentLang === 'id'
    ? <span class="active" aria-current="page">ID</span>
    : <a href={otherPath}>ID</a>}
  <span class="divider">/</span>
  {currentLang === 'en'
    ? <span class="active" aria-current="page">EN</span>
    : <a href={otherPath}>EN</a>}
</div>

<style>
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .active { color: var(--text-primary); }
  .divider { opacity: 0.4; }
  a { transition: color 200ms ease; }
  a:hover { color: var(--hover); }
</style>
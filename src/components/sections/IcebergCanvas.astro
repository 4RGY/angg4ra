---
/**
 * IcebergCanvas.astro
 * -------------------
 * Canvas scene "Midnight Arctic" — FIXED full-viewport background.
 *
 * v11 (Sprint 2):
 * - Dipindah dari dalam <section.hero> → fixed di body (BaseLayout).
 * - Hanya dirender kalau <body> punya atribut `data-dive` (homepage doang;
 *   halaman lain tidak keganggu scene ngambang).
 * - Scene = "satu laut kontinu": scroll = kamera nyilem 0m → −4000m,
 *   fauna muncul per depth zone (lihat iceberg-scene.js).
 *
 * - `<canvas>` hanya di-render di client (bukan SSR) lewat script
 * - three.js di-dynamic-import → tidak ikut bundle awal
 * - initIcebergScene() mengurus guard sendiri:
 *     prefers-reduced-motion → null (teks tetap tampil)
 *     layar < 768px / WebGL absent → null (fallback statis)
 *
 * Props: none.
 */
---

<div class="dive-canvas" aria-hidden="true" data-iceberg-canvas>
  <!-- Vignette tekanan-air (Fitur #5): opacity dikendalikan scene per-frame -->
  <div class="dive-vignette" data-dive-vignette></div>
  <!-- Ripple permukaan-air (Fitur #3): opacity naik pas scroll cepet -->
  <div class="dive-ripple" data-dive-ripple></div>
</div>

<script>
  // Hanya jalan di client; container dijamin ada.
  // Expose api (setDive) ke window buat GSAP ScrollTrigger di gsap-animations.js
  const container = document.querySelector('[data-iceberg-canvas]');
  if (container && document.body.hasAttribute('data-dive')) {
    import('../../scripts/iceberg-scene.js').then(({ initIcebergScene }) =>
      initIcebergScene(container).then((api) => {
        if (api) {
          window.__dive = api;
          const range = document.documentElement.scrollHeight - window.innerHeight;
          api.setDive(range > 0 ? window.scrollY / range : 0);
        }
      }),
    ).catch((error) => console.error('Dive scene unavailable:', error));
    // GSAP ScrollTrigger → sinkron scroll ke dive scene. Dynamic import bareng
    // scene biar dijamin ke-bundle (Astro quirk: static import di BaseLayout ke-drop).
    import('../../scripts/gsap-animations.js').catch((e) =>
      console.error('gsap-animations load failed:', e),
    );
  }
</script>

<style>
  .dive-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none; /* biar teks/CTA tetap bisa diklik */
    z-index: -1; /* di belakang semua konten */
  }
  .dive-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── VIGNETTE (Fitur #5) — tekanan air makin pekat di kedalaman ── */
  .dive-vignette {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background: radial-gradient(
      ellipse at center,
      transparent 42%,
      rgba(2, 6, 10, 0.55) 78%,
      rgba(1, 3, 7, 0.92) 100%
    );
    z-index: 1;
    will-change: opacity;
  }

  /* ── RIPPLE (Fitur #3) — kilau/garis air halus pas scroll cepat ── */
  .dive-ripple {
    position: absolute;
    inset: -10%;
    opacity: 0;
    background: repeating-linear-gradient(
      175deg,
      transparent 0px,
      transparent 26px,
      rgba(125, 200, 226, 0.035) 28px,
      transparent 31px
    );
    z-index: 2;
    mix-blend-mode: screen;
    will-change: opacity, transform;
  }
</style>

---
const { lang = 'id' } = Astro.props;

const t = lang === 'id' ? {
  eyebrow:      'Ekspedisi Arktik · 0 m · Permukaan',
  greeting:     'Halo, saya Anggara.',
  tagline:      'Saya menulis kode dan mengolah data menjadi sesuatu yang berguna.',
  cta_projects: 'Lihat Proyek',
  cta_cv:       'Unduh CV',
  scroll:       'Mulai menyelam',
} : {
  eyebrow:      'Arctic Expedition · 0 m · Surface',
  greeting:     "Hello, I'm Anggara.",
  tagline:      'I write code and turn data into something that people can use.',
  cta_projects: 'View Projects',
  cta_cv:       'Download CV',
  scroll:       'start diving',
};

const stat11 = lang === 'id' ? 'Proyek Selesai' : 'Projects Done';
const stat500 = lang === 'id' ? 'Jam Mengajar' : 'Hours Teaching';
---

<section class="hero" id="surface" data-hero aria-label={lang === 'id' ? 'Perkenalan' : 'Introduction'}>
  <!-- Scene arctic kini FIXED di BaseLayout (data-dive, homepage only) —
       hero ini cuma konten di atas scene. -->

  <!-- Scrim halus biar teks tetap terbaca di atas scene -->
  <div class="hero-scrim" aria-hidden="true"></div>

  <!-- Konten utama -->
  <div class="hero-content">
    <p class="hero-eyebrow" id="hero-eyebrow">{t.eyebrow}</p>

    <h1 class="hero-title" id="hero-title">
      <span class="title-line">
        <span id="typed-output">{t.greeting}</span>
      </span>
    </h1>

    <p class="hero-tagline" id="hero-tagline">{t.tagline}</p>

    <div class="hero-cta" id="hero-cta">
      <a href={`/${lang}/#projects`} class="btn-primary">{t.cta_projects}</a>
      <a href="/cv-anggara.pdf" download="cv-anggara.pdf" class="btn-ghost">{t.cta_cv}</a>
    </div>

    <div class="hero-stats" id="hero-stats">
      <div class="stat-chip">
        <span class="stat-value font-mono" data-target="11">11</span>
        <span class="stat-label">{stat11}</span>
      </div>
      <div class="stat-chip">
        <span class="stat-value font-mono" data-target="500">500</span>
        <span class="stat-label">{stat500}</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="#about" class="scroll-indicator" id="scroll-indicator" aria-label={t.scroll}>
    <span>{t.scroll}</span>
    <span class="depth-readout font-mono">0m</span>
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</section>

<style>
  /* ─────────────────────────────────────────────
     HERO — "Permukaan" (0m)
     Teks jadi raja; scene arctic mengisi sisa.
  ───────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    width: 100%;
    max-width: none;
    display: flex;
    align-items: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* Konten tetap di kolom ~1200px meski scene full-bleed */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin-left: max(2rem, calc((100vw - 1200px) / 2 + 2rem));
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Scrim: gradien halus kiri→kanan biar teks kontras di atas scene,
     TAPI jangan nutupin scene kanan (iceberg) — hanya di area teks */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg-main) 0%, color-mix(in srgb, var(--bg-main) 70%, transparent) 34%, transparent 58%),
      linear-gradient(0deg, var(--bg-main) 0%, transparent 20%, transparent 80%, var(--bg-main) 100%);
    opacity: 0.85;
  }

  .hero-eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hero-eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--accent);
    opacity: 0.6;
  }

  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--text-primary);
    margin-bottom: 1.6rem;
    text-wrap: balance;
  }
  .title-line { display: block; }

  .hero-tagline {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 52ch;
    margin-bottom: 2.4rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 3.2rem;
  }

  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    padding: 0.78rem 1.7rem;
    background: var(--accent);
    color: #04121f;
    border: 1px solid var(--accent);
    border-radius: 999px;
    text-decoration: none;
    transition: background 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .btn-primary:hover {
    background: var(--hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 26px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    padding: 0.78rem 1.7rem;
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    transition: border-color 220ms ease, background 220ms ease, transform 220ms ease;
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateY(-2px);
  }

  /* Stats — ringkas, bawah kiri */
  .hero-stats {
    display: flex;
    gap: 2.4rem;
  }
  .stat-chip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-left: 2px solid var(--accent);
    padding-left: 0.85rem;
  }
  .stat-value {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.1;
  }
  .stat-label {
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Scroll indicator — kiri bawah, jadi "depth marker" pertama */
  .scroll-indicator {
    position: absolute;
    bottom: 2.2rem;
    left: 2rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    opacity: 0;
    animation: fadeIn 1s ease 3.4s forwards;
    transition: color 200ms ease;
  }
  .scroll-indicator:hover { color: var(--accent); }
  .depth-readout {
    color: var(--accent);
    font-size: 0.66rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .arrow {
    display: inline-block;
    animation: driftDown 2.4s ease infinite;
  }
  @keyframes driftDown {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50%      { transform: translateY(5px); opacity: 1; }
  }
  @keyframes fadeIn { to { opacity: 1; } }

  /* Light mode: scrim & teks tetap kontras di atas es terang */
  @media (max-width: 768px) {
    .hero { align-items: flex-end; padding: 5rem 1.4rem 4.5rem; }
    .hero-scrim {
      background:
        linear-gradient(0deg, var(--bg-main) 2%, color-mix(in srgb, var(--bg-main) 55%, transparent) 45%, transparent 80%);
      opacity: 0.9;
    }
    .hero-content { margin-left: 0; max-width: 100%; }
    .hero-stats { gap: 1.6rem; }
    .scroll-indicator { left: 1.4rem; bottom: 1.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator { animation: none; opacity: 1; }
    .arrow { animation: none; }
  }
</style>
